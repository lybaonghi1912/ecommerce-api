NODE_ENV=development
PORT=3000

POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_app
POSTGRES_PASSWORD=replace_with_your_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecommerce_app:replace_with_your_password@localhost:5432/ecommerce?schema=public

ADMIN_USERNAME=admin
ADMIN_FULLNAME=Administrator
ADMIN_PASSWORD=replace_with_a_random_password

JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=ecommerce-api
JWT_AUDIENCE=ecommerce-client


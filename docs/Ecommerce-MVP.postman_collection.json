{
  "info": {
    "name": "E-commerce MVP - Demo và kiểm tra",
    "description": "Chạy từ 01 đến 20. Nhập admin_password trong environment local. Chạy thủ công sẽ tạo tài khoản/sản phẩm/đơn demo; collection không tự xóa chúng.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "customer_username",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "pid",
      "value": "",
      "type": "string"
    },
    {
      "key": "oid",
      "value": "",
      "type": "string"
    },
    {
      "key": "shipid",
      "value": "",
      "type": "string"
    },
    {
      "key": "invalid_token",
      "value": "invalid-token-for-negative-test",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health/live",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('customer_username', 'demo_' + Date.now() + '_' + Math.floor(Math.random() * 1000000));",
              "pm.collectionVariables.set('customer_password', 'Demo_' + Date.now() + '_Mvp2026!');",
              "['admin_token','customer_token','pid','oid','shipid'].forEach(key => pm.collectionVariables.unset(key));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.equal(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health/ready",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.equal(200));",
              "pm.test('Database up', () => pm.expect(pm.response.json().database).to.equal('up'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.equal(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('admin_token', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Admin creates product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/products",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pname\": \"{{customer_username}}_keyboard\",\n  \"price\": \"199000.00\",\n  \"quantity\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.expect(pm.response.code).to.equal(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('pid', pm.response.json().product.pid);",
              "pm.test('Exact price', () => pm.expect(pm.response.json().product.price).to.equal('199000.00'));"
            ]
          }
        }
      ]
    },
    {
